{
  "name": "crowd-code-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @codegame/server --filter @codegame/web dev",
    "start": "pnpm --filter @codegame/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "load-test": "pnpm --filter @codegame/server load-test"
  }
}
